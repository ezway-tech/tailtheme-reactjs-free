#!/usr/bin/env sh

# Prettier + ESLint on staged files only (see lint-staged in package.json).

echo ""
echo "[husky pre-commit] Prettier + ESLint on staged files…"
echo ""

if ! npx lint-staged; then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  COMMIT BLOCKED (pre-commit)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  Details: see file:line errors above."
  echo ""
  echo "  Try:"
  echo "    npm run format"
  echo "    npm run lint:fix"
  echo "    git add -u && git commit"
  echo ""
  echo "  WSL/Windows CRLF (Delete ␍)?"
  echo "    git config core.autocrlf false"
  echo "    npm run lint -- --fix"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 1
fi

echo "[husky pre-commit] OK."
echo ""
